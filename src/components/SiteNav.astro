---
import { visibleNavItems } from '../config/site';

interface Props {
  pathname: string;
}
const { pathname } = Astro.props;
const items = visibleNavItems();
---

<nav aria-label="Main">
  <button class="nav-toggle" type="button" aria-expanded="false" aria-controls="site-nav-list">
    <span class="visually-hidden">Menu</span>
    <span class="nav-toggle__bars" aria-hidden="true"></span>
  </button>
  <ul id="site-nav-list" class="nav-list">
    {items.map((item) => (
      <li>
        <a href={item.href} aria-current={pathname === item.href ? 'page' : undefined}>
          {item.label}
        </a>
      </li>
    ))}
  </ul>
</nav>

<script>
  const toggle = document.querySelector<HTMLButtonElement>('.nav-toggle');
  toggle?.addEventListener('click', () => {
    const open = toggle.getAttribute('aria-expanded') !== 'true';
    toggle.setAttribute('aria-expanded', String(open));
  });
  document.addEventListener('keydown', (event) => {
    if (event.key !== 'Escape' || toggle?.getAttribute('aria-expanded') !== 'true') return;
    toggle.setAttribute('aria-expanded', 'false');
    toggle.focus();
  });
</script>

<style>
  .nav-list {
    list-style: none;
    padding: 0;
  }
  .nav-list a {
    display: block;
    font-size: 0.875rem;
    text-decoration: none;
  }
  .nav-list a:hover,
  .nav-list a[aria-current='page'] {
    text-decoration: underline 1px var(--color-accent);
    text-underline-offset: 0.5em;
  }

  .nav-toggle {
    display: grid;
    place-items: center;
    inline-size: 2.25rem;
    block-size: 2.25rem;
    padding: 0;
    border: 0;
    background: transparent;
    color: var(--color-text);
    cursor: pointer;
  }
  .nav-toggle__bars,
  .nav-toggle__bars::after {
    display: block;
    inline-size: 1.25rem;
    block-size: 1px;
    background: currentColor;
  }
  .nav-toggle__bars {
    position: relative;
    transform: translateY(-0.2rem);
  }
  .nav-toggle__bars::after {
    content: '';
    position: absolute;
    inset-block-start: 0.4rem;
  }

  @media (max-width: 767.98px) {
    .nav-list {
      display: none;
      position: absolute;
      inset-block-start: 100%;
      inset-inline: 0;
      z-index: 10;
      padding: var(--space-2) var(--gutter) var(--space-4);
      background: var(--color-bg);
      border-block-end: 1px solid var(--color-rule);
    }
    .nav-toggle[aria-expanded='true'] + .nav-list {
      display: flex;
      flex-direction: column;
    }
    .nav-list a {
      padding-block: var(--space-2);
      font-size: var(--step-0);
    }
  }

  @media (min-width: 768px) {
    .nav-toggle {
      display: none;
    }
    .nav-list {
      display: flex;
      gap: var(--space-5);
    }
  }
</style>
