---
import { heroKicker, site } from '../config/site';
import EnsoMark from './EnsoMark.astro';
---

<section class="hero container">
  <p class="hero__katakana" lang="ja" aria-hidden="true">
    {site.nameKatakana}
  </p>
  <div class="hero__body">
    <p class="label">{heroKicker(site.role, site.stack)}</p>
    <h1 class="hero__title">
      I build backends
      <br /> and write about them.
    </h1>
    <p class="hero__lede">
      12+ years with PHP, Laravel and Go. This site is my notebook for code, the books I read and
      the tools I use.
    </p>
    <p class="hero__links">
      <a class="hero__link hero__link--primary" href="/blog">
        Read the blog →
      </a>
      <a class="hero__link" href={site.cvPath}>
        View CV →
      </a>
    </p>
  </div>
  <div class="hero__enso">
    <EnsoMark />
  </div>
</section>

<style>
  .hero {
    position: relative;
    isolation: isolate;
    display: grid;
    padding-block: var(--space-6);
    overflow: clip;
    /* Lets the ensō bleed to the viewport edge on mobile without horizontal scroll. */
    /* 6.5vw (the preferred value of --gutter) rather than var(--gutter): Chrome rejects clamp() in this property. */
    overflow-clip-margin: 6.5vw;
  }

  .hero__katakana {
    display: none;
    writing-mode: vertical-rl;
    font-family: var(--font-heading);
    font-size: var(--step--1);
    letter-spacing: 0.4em;
    line-height: 1;
    color: var(--color-muted);
  }

  .hero__body > * + * {
    margin-block-start: var(--space-5);
  }
  .hero__title {
    font-size: var(--step-4);
    line-height: 1.15;
  }
  .hero__lede {
    max-inline-size: 29em;
    font-size: clamp(0.9375rem, 0.85rem + 0.45vw, 1.1875rem);
    line-height: 1.85;
    color: var(--color-muted);
  }
  .hero__links {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-4);
    padding-block-start: var(--space-2);
  }
  .hero__link {
    padding-block-end: var(--space-1);
    border-block-end: 1px solid var(--color-rule);
    text-decoration: none;
  }
  .hero__link--primary {
    border-block-end-color: var(--color-accent);
  }

  .hero__enso {
    position: absolute;
    z-index: -1;
    inset-block-start: var(--space-5);
    inset-inline-end: -7rem;
    inline-size: 85vw;
  }

  @media (min-width: 768px) {
    .hero {
      grid-template-columns: 2rem 1fr;
      column-gap: clamp(var(--space-4), 4vw, var(--space-6));
      padding-block: 4.5rem 5.5rem;
      border-block-end: 1px solid var(--color-rule);
    }
    .hero__katakana {
      display: block;
    }
    .hero__links {
      flex-direction: row;
      gap: var(--space-5);
    }
    .hero__enso {
      inset-block-start: 3.25rem;
      inset-inline-end: -1.5rem;
      inline-size: clamp(25rem, 37.5vw, 30rem);
    }
  }

  /* The tablet mockup wraps "them." onto a third line. */
  @media (min-width: 768px) and (max-width: 1099.98px) {
    .hero__title {
      max-inline-size: 9em;
    }
  }

  @media (min-width: 1100px) {
    .hero {
      padding-block: 6.5rem 9rem;
    }
    .hero__katakana {
      font-size: 0.875rem;
      letter-spacing: 0.65em;
    }
  }
</style>
