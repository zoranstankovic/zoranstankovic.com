---
interface Props {
  tags: string[];
}
const { tags } = Astro.props;
---

{tags.length > 0 && (
  <ul class="tags" aria-label="Tags">
    {tags.map((tag) => (
      <li class="tags__tag">{tag}</li>
    ))}
  </ul>
)}

<style>
  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    padding: 0;
    list-style: none;
  }
  .tags__tag {
    padding: 0.125rem var(--space-2);
    border: 1px solid var(--color-rule);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    line-height: 1.6;
  }
</style>
