---
// Brush-drawn ensō: a filled stroke that thickens at the lower left and fades out at the top,
// with a turbulence filter for ink edges and a dashed mask for the dry-brush tail.
// Colour comes from `currentColor`; the size follows the parent's inline size.
import { uniqueId } from '../lib/unique-id';

const filterId = uniqueId('enso-brush');
const maskId = uniqueId('enso-dry');
