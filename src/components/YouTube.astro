---
// A link to the video on youtube.com, not an embed: the thumbnail is served from this site, so a
// visitor's browser contacts YouTube only when they follow the link.
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import { thumbnailFor, youtubeWatchUrl } from '../lib/youtube';

interface Props {
  id: string;
  title: string;
}
const { id, title } = Astro.props;

const thumbnails = import.meta.glob<{ default: ImageMetadata }>('/src/assets/youtube/*.jpg', {
  eager: true,
});
const thumbnail = thumbnailFor(id, thumbnails).default;
---

<a class="youtube" href={youtubeWatchUrl(id)} target="_blank" rel="noopener">
  <span class="youtube__media">
    <Image
      class="youtube__thumb"
      src={thumbnail}
      alt=""
      widths={[360, 720, 1080, 1440]}
      sizes="(min-width: 1100px) 45rem, 100vw"
    />
    <svg class="youtube__play" viewBox="0 0 64 64" aria-hidden="true" focusable="false">
      <circle cx="32" cy="32" r="32"></circle>
      <path d="M26 20 L46 32 L26 44 Z"></path>
    </svg>
  </span>
  <span class="youtube__caption">
    <span class="youtube__title">{title}</span>
    <span class="label">
      Watch on YouTube <span aria-hidden="true">↗</span>
    </span>
    <span class="visually-hidden"> (opens in a new tab)</span>
  </span>
</a>

<style>
  .youtube {
    display: block;
    margin-block: var(--space-5);
    background: var(--color-surface);
    color: inherit;
    text-decoration: none;
  }
  .youtube__media {
    position: relative;
    display: block;
  }
  .youtube__thumb {
    display: block;
    inline-size: 100%;
    block-size: auto;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    margin: 0;
  }
  .youtube__play {
    position: absolute;
    inset-block-start: 50%;
    inset-inline-start: 50%;
    inline-size: clamp(3rem, 12%, 4.5rem);
    translate: -50% -50%;
    transition: scale 150ms ease;
  }
  .youtube__play circle {
    fill: var(--color-accent);
  }
  .youtube__play path {
    fill: #fff;
  }
  .youtube__caption {
    display: grid;
    gap: var(--space-1);
    padding: var(--space-3) var(--space-4);
  }
  .youtube__title {
    font-family: var(--font-heading);
    line-height: 1.4;
  }
  .youtube:hover .youtube__title {
    text-decoration: underline;
    text-decoration-thickness: 1px;
  }
  .youtube:hover .youtube__play {
    scale: 1.08;
  }
  @media (prefers-reduced-motion: reduce) {
    .youtube__play {
      transition: none;
    }
  }
</style>
