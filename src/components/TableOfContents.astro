---
import type { MarkdownHeading } from 'astro';

interface Props {
  headings: MarkdownHeading[];
}
const items = Astro.props.headings.filter((heading) => heading.depth === 2);
---

{items.length >= 2 && (
  <nav class="toc" aria-labelledby="toc-title">
    <h2 class="toc__title" id="toc-title">
      <span class="toc__kanji" lang="ja">
        目次
      </span>
      <span class="label">Contents</span>
    </h2>
    <ol class="toc__list">
      {items.map((heading) => (
        <li>
          <a href={`#${heading.slug}`}>{heading.text}</a>
        </li>
      ))}
    </ol>
  </nav>
)}

<style>
  /* A table of contents after the article is useless, so it only shows next to it. */
  .toc {
    display: none;
  }
  @media (min-width: 1100px) {
    .toc {
      display: block;
      padding-block-end: var(--space-5);
      border-block-end: 1px solid var(--color-rule);
    }
  }
  .toc__title {
    display: flex;
    align-items: baseline;
    gap: var(--space-2);
  }
  .toc__kanji {
    font-size: 1.25rem;
    line-height: 1;
  }
  .toc__list {
    display: grid;
    gap: var(--space-2);
    margin-block-start: var(--space-4);
    padding-inline-start: var(--space-4);
    list-style: none;
    border-inline-start: 1px solid var(--color-rule);
    font-size: 0.875rem;
    line-height: 1.5;
  }
  .toc__list a {
    color: var(--color-muted);
    text-decoration: none;
  }
  .toc__list a:hover {
    color: var(--color-text);
  }
</style>
