---
import Base from '../layouts/Base.astro';
import { site } from '../config/site';
import Hero from '../components/Hero.astro';
import InfoCard from '../components/InfoCard.astro';
import PostList from '../components/PostList.astro';
import SectionHeading from '../components/SectionHeading.astro';
import { getEntry } from 'astro:content';
import { getPosts } from '../lib/content';
import { formatMonthYear } from '../lib/format';
import { toListEntry } from '../lib/posts';

const latestPosts = (await getPosts()).slice(0, 5).map(toListEntry);

const now = await getEntry('pages', 'now');
const uses = await getEntry('pages', 'uses');
// A missing file should fail the build, not render an empty card.
if (!now || !uses) throw new Error('src/content/pages needs now.md and uses.md');
---

<Base title={site.name} description={site.description}>
  <Hero />
  <div class="container home">
    <section class="home__writing">
      <SectionHeading kanji="記事" label="Writing" href="/blog" linkLabel="All posts" />
      <PostList entries={latestPosts} />
      <a class="home__more" href="/blog">
        All posts →
      </a>
    </section>
    <div class="home__cards">
      <InfoCard
        kanji="今"
        label="Now"
        href="/now"
        linkLabel={now.data.updated ? `Updated ${formatMonthYear(now.data.updated)}` : 'More'}
      >
        {now.data.summary.map((line) => (
          <p>{line}</p>
        ))}
      </InfoCard>
      <InfoCard kanji="道具" label="Uses" href="/uses" linkLabel="Full setup">
        <ul class="home__uses">
          {uses.data.summary.map((line) => (
            <li>{line}</li>
          ))}
        </ul>
      </InfoCard>
    </div>
  </div>
</Base>

<style>
  .home {
    display: grid;
    gap: var(--space-6);
    padding-block-start: var(--space-6);
  }

  /* On mobile "All posts" sits below the list; from 768px it sits in the section heading. */
  .home__more {
    display: inline-block;
    margin-block-start: var(--space-4);
    font-size: 0.875rem;
    color: var(--color-muted);
    text-decoration: none;
  }
  @media (max-width: 767.98px) {
    .home__writing :global(.section-heading__link) {
      display: none;
    }
  }
  @media (min-width: 768px) {
    .home {
      gap: var(--space-7);
      padding-block-start: var(--space-7);
    }
    .home__more {
      display: none;
    }
  }
  @media (min-width: 1100px) {
    .home {
      gap: var(--space-8);
      padding-block-start: var(--space-8);
    }
  }
  .home__cards {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr));
    gap: var(--space-5);
  }
  .home__uses {
    list-style: none;
    padding: 0;
    font-family: var(--font-mono);
    font-size: 0.875rem;
    line-height: 1.8;
  }
</style>
