---
import Base from '../layouts/Base.astro';
import ThemeToggle from '../components/ThemeToggle.astro';
---
<Base title="Zoran Stankovic" description="Backend developer writing about PHP, Laravel and Go.">
  <div class="container">
    <ThemeToggle />
    <p class="label">Backend developer — Magdeburg, DE</p>
    <h1>I build backends and write about them.</h1>
    <p>12+ years with PHP, Laravel and Go. This site is my notebook for code, the books I read and the tools I use.</p>
    <p style="font-family: var(--font-heading)">ゾラン・スタンコビッチ 作品 記事 今 道具 本 目次 月</p>
  </div>
</Base>
